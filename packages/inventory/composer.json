{
    "name": "ecommerce/inventory",
    "description": "Inventory management package for eCommerce",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "ecommerce/core": "*",
        "ecommerce/product": "*"
    },
    "autoload": {
        "psr-4": {
            "ECommerce\\Inventory\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ECommerce\\Inventory\\Providers\\InventoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
