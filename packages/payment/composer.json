{
    "name": "ecommerce/payment",
    "description": "Payment processing package for eCommerce",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "ecommerce/core": "*",
        "ecommerce/order": "*",
        "stripe/stripe-php": "^20.0"
    },
    "autoload": {
        "psr-4": {
            "ECommerce\\Payment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ECommerce\\Payment\\Providers\\PaymentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
