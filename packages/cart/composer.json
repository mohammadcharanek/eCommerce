{
    "name": "ecommerce/cart",
    "description": "Shopping cart management package for eCommerce",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "ecommerce/core": "*",
        "ecommerce/user": "*",
        "ecommerce/product": "*",
        "ecommerce/inventory": "*",
        "ecommerce/coupon": "*"
    },
    "autoload": {
        "psr-4": {
            "ECommerce\\Cart\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ECommerce\\Cart\\Providers\\CartServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
